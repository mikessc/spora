# Copiar a .env (nunca commitear .env). Sin .env se usan los valores de desarrollo.
PORT=3000
DB_HOST=localhost
DB_PORT=5433
DB_USER=spora
DB_PASSWORD=spora
DB_NAME=spora
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=
COOKIE_SECRET=
ASSET_URL_PREFIX=http://localhost:3000/assets/
# Vendure manda telemetría anónima por defecto; en Spora va apagada.
VENDURE_DISABLE_TELEMETRY=true
# Tipo de cambio (ADR 0004). Con BCCR_EMAIL y BCCR_TOKEN se usa el web service del BCCR (suscripción gratuita en
# https://www.bccr.fi.cr/indicadores-economicos/servicio-web); sin ellos, la tasa fija de BCCR_SIMULATED_RATE.
BCCR_NAME=Spora
BCCR_EMAIL=
BCCR_TOKEN=
BCCR_SIMULATED_RATE=515.00
# Pagos (M4). Clave para cifrar las credenciales de los comercios (SINPE, IBAN, PayPal, Tilopay). Obligatoria en producción.
SPORA_ENCRYPTION_KEY=
# Pasarelas reales a usar (con las credenciales de cada tienda); vacío = todas simuladas. Ej.: paypal,tilopay
SPORA_PAGOS_REALES=
# Tilopay: "Test" o "Production"; si se define, se exige que la transacción consultada sea de ese entorno.
TILOPAY_ENTORNO=
# URL pública del backend (página de la pasarela simulada) y dominio de las tiendas (URLs de retorno permitidas).
BACKEND_PUBLIC_URL=http://localhost:3000
STORE_BASE_DOMAIN=spora.localhost
# URL pública de cada tienda ({tienda} = subdominio). La usa la vista previa de "Mi tienda" en el Panel Spora.
STOREFRONT_URL=http://{tienda}.spora.localhost:4000
# Envíos (M5). Transportistas reales a usar; vacío = simulados. Ej.: trackingapp
SPORA_ENVIOS_REALES=
# API de TrackingApp (instancia local de mikessc/TrackingApp o la de producción).
TRACKINGAPP_API_URL=http://localhost:8787/v1
# Comisiones (M6): porcentaje para comercios sin acuerdo propio.
SPORA_COMISION_POR_DEFECTO=5
# Cierre de mes: los pedidos pendientes con al menos estos días (hora de CR) se facturan aunque nadie confirme la
# entrega ("facturado al cierre sin confirmar entrega"). Los más nuevos esperan al cierre siguiente.
SPORA_DIAS_GRACIA_CIERRE=7
# Meilisearch (índice del marketplace). Vacío = índice apagado.
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=solo-desarrollo-meili
