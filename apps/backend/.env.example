# Copiar a .env (nunca commitear .env). Sin .env se usan los valores de desarrollo.
PORT=3000
DB_HOST=localhost
DB_PORT=5433
DB_USER=spora
DB_PASSWORD=spora
DB_NAME=spora
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=
COOKIE_SECRET=
ASSET_URL_PREFIX=http://localhost:3000/assets/
ADMIN_UI_PORT=3002
# Vendure manda telemetría anónima por defecto; en Spora va apagada.
VENDURE_DISABLE_TELEMETRY=true
