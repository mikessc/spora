{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"],
    "paths": {
      "@/gql": ["./src/gql/graphql.ts"],
      "@/vdb/*": ["./node_modules/@vendure/dashboard/src/lib/*"]
    }
  },
  "include": ["src/**/dashboard/**/*.ts", "src/**/dashboard/**/*.tsx", "src/gql"]
}
