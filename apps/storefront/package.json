{
  "name": "@spora/storefront",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "build": "pnpm build:client",
    "dev": "node scripts/build-client.mjs --watch --serve",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "node scripts/e2e.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@spora/api-client": "workspace:*",
    "@spora/themes": "workspace:*",
    "hono": "^4.9.0",
    "sibujs": "4.15.2",
    "sibujs-ui": "1.10.0",
    "@spora/ui": "workspace:*",
    "@spora/shared": "workspace:*",
    "@spora/web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.55.0",
    "tsx": "^4.20.0"
  }
}
